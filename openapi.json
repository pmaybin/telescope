{
  "components": {
    "schemas": {
      "DevToken": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Seconds until the token expires.",
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "DevToken",
        "type": "object"
      },
      "DevTokenRequest": {
        "properties": {
          "sub": {
            "default": "dev-user",
            "maxLength": 64,
            "minLength": 1,
            "title": "Sub",
            "type": "string"
          }
        },
        "title": "DevTokenRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "License": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "spdx_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "SPDX identifier; null when GitHub reports NOASSERTION.",
            "title": "Spdx Id"
          }
        },
        "required": [
          "spdx_id",
          "name"
        ],
        "title": "License",
        "type": "object"
      },
      "PageInfo": {
        "properties": {
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "has_prev": {
            "title": "Has Prev",
            "type": "boolean"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Offset of this page in offset mode; null in cursor mode.",
            "title": "Offset"
          },
          "prev_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Cursor"
          },
          "provisional_reason": {
            "anyOf": [
              {
                "enum": [
                  "preview-disabled",
                  "preview-skipped",
                  "preview-inexact",
                  "preview-unavailable"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why a provisional response (`snapshot.complete` false) has no items: there is no trustworthy first page yet. Null when complete, or when the provisional items are an exact first page.",
            "title": "Provisional Reason"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of repositories matching the filters. Null while the snapshot is still loading (`snapshot.complete` false), unless the provisional page came from Search.",
            "title": "Total"
          }
        },
        "required": [
          "limit",
          "total",
          "has_next",
          "has_prev",
          "next_cursor",
          "prev_cursor"
        ],
        "title": "PageInfo",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "retry_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Seconds; mirrors `Retry-After`.",
            "title": "Retry After"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ProgressInfo": {
        "properties": {
          "pages_done": {
            "description": "Upstream pages fetched so far.",
            "title": "Pages Done",
            "type": "integer"
          },
          "pages_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Upstream pages needed; null until page 1 lands.",
            "title": "Pages Total"
          }
        },
        "required": [
          "pages_done",
          "pages_total"
        ],
        "title": "ProgressInfo",
        "type": "object"
      },
      "RateLimitInfo": {
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining"
          },
          "reset_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reset At"
          }
        },
        "required": [
          "authenticated",
          "limit",
          "remaining",
          "reset_at"
        ],
        "title": "RateLimitInfo",
        "type": "object"
      },
      "Repo": {
        "description": "A repository, normalised: empty strings from GitHub become null.",
        "properties": {
          "archived": {
            "title": "Archived",
            "type": "boolean"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "fork": {
            "title": "Fork",
            "type": "boolean"
          },
          "forks": {
            "title": "Forks",
            "type": "integer"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "html_url": {
            "title": "Html Url",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "license": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/License"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "open_issues": {
            "title": "Open Issues",
            "type": "integer"
          },
          "pushed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pushed At"
          },
          "stars": {
            "title": "Stars",
            "type": "integer"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "id",
          "name",
          "full_name",
          "html_url",
          "description",
          "language",
          "stars",
          "forks",
          "open_issues",
          "archived",
          "fork",
          "license",
          "topics",
          "created_at",
          "updated_at",
          "pushed_at"
        ],
        "title": "Repo",
        "type": "object"
      },
      "RepoPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Repo"
            },
            "title": "Items",
            "type": "array"
          },
          "org": {
            "title": "Org",
            "type": "string"
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          },
          "rate_limit": {
            "$ref": "#/components/schemas/RateLimitInfo"
          },
          "snapshot": {
            "$ref": "#/components/schemas/SnapshotInfo"
          }
        },
        "required": [
          "org",
          "items",
          "page",
          "snapshot",
          "rate_limit"
        ],
        "title": "RepoPage",
        "type": "object"
      },
      "RepoType": {
        "enum": [
          "all",
          "sources",
          "forks"
        ],
        "title": "RepoType",
        "type": "string"
      },
      "SnapshotInfo": {
        "properties": {
          "complete": {
            "default": true,
            "description": "False while the cold load is still running: the response is provisional, paging is disabled and the client should re-request after `Retry-After`.",
            "title": "Complete",
            "type": "boolean"
          },
          "cursor_from_older_snapshot": {
            "description": "True when the cursor was issued against a different snapshot; rows whose sort key changed may have moved.",
            "title": "Cursor From Older Snapshot",
            "type": "boolean"
          },
          "fetched_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the dataset was last fetched or revalidated. Null while loading.",
            "title": "Fetched At"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Content hash of the upstream dataset this page was computed from. Null while the snapshot is still loading.",
            "title": "Id"
          },
          "progress": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProgressInfo"
              },
              {
                "type": "null"
              }
            ],
            "description": "Load progress; non-null only when `complete` is false."
          },
          "repo_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Repositories in the org before filtering. Null while loading.",
            "title": "Repo Count"
          },
          "stale": {
            "description": "True when served past its TTL because GitHub was unavailable or rate limited.",
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "fetched_at",
          "repo_count",
          "stale",
          "cursor_from_older_snapshot"
        ],
        "title": "SnapshotInfo",
        "type": "object"
      },
      "SortField": {
        "enum": [
          "stars",
          "updated",
          "pushed",
          "name"
        ],
        "title": "SortField",
        "type": "string"
      },
      "SortOrder": {
        "enum": [
          "asc",
          "desc"
        ],
        "title": "SortOrder",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Required when `AUTH_MODE` is `dev` (mint one with `POST /api/dev/token`) or `jwt`. Not used by `tailscale` or `none`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Telescope API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/dev/token": {
      "post": {
        "operationId": "createDevToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/DevTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevToken"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cross-site request, or organisation not on the allowlist"
          },
          "404": {
            "description": "Not in dev auth mode"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mint a short-lived dev JWT (AUTH_MODE=dev only; not a security boundary)"
      }
    },
    "/api/orgs/{org}/repos": {
      "get": {
        "operationId": "listOrgRepos",
        "parameters": [
          {
            "description": "GitHub organisation login.",
            "in": "path",
            "name": "org",
            "required": true,
            "schema": {
              "description": "GitHub organisation login.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$",
              "title": "Org",
              "type": "string"
            }
          },
          {
            "description": "Primary language, case-insensitive exact match. Use `none` for repositories with no detected language.",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Primary language, case-insensitive exact match. Use `none` for repositories with no detected language.",
              "title": "Language"
            }
          },
          {
            "description": "Minimum star count (inclusive).",
            "in": "query",
            "name": "min_stars",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Minimum star count (inclusive).",
              "title": "Min Stars"
            }
          },
          {
            "description": "Filter by archived state. Omit for both.",
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by archived state. Omit for both.",
              "title": "Archived"
            }
          },
          {
            "description": "Source repositories, forks, or all.",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RepoType",
              "default": "all",
              "description": "Source repositories, forks, or all."
            }
          },
          {
            "description": "`updated` = GitHub `updated_at`; `pushed` = last push (`pushed_at`).",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortField",
              "default": "stars",
              "description": "`updated` = GitHub `updated_at`; `pushed` = last push (`pushed_at`)."
            }
          },
          {
            "description": "Defaults to `desc` for stars/updated/pushed and `asc` for name.",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to `desc` for stars/updated/pushed and `asc` for name.",
              "title": "Order"
            }
          },
          {
            "description": "Page size.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Page size.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Opaque cursor from `page.next_cursor` or `page.prev_cursor`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 1024,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from `page.next_cursor` or `page.prev_cursor`.",
              "title": "Cursor"
            }
          },
          {
            "description": "Zero-based offset into the filtered, sorted list. Mutually exclusive with `cursor` (400 `invalid-pagination` if both are given).",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100000,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Zero-based offset into the filtered, sorted list. Mutually exclusive with `cursor` (400 `invalid-pagination` if both are given).",
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoPage"
                }
              }
            },
            "description": "A page of repositories.",
            "headers": {
              "Cache-Control": {
                "description": "`private, max-age=60`, `no-cache` when stale, or `no-store` on provisional pages.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak validator for this page (absent on provisional pages).",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds to wait before re-requesting; only on provisional pages (`snapshot.complete` false).",
                "schema": {
                  "type": "integer"
                }
              },
              "X-GitHub-RateLimit-Limit": {
                "description": "Upstream rate limit ceiling, when known.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-GitHub-RateLimit-Remaining": {
                "description": "Upstream requests remaining, when known.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-GitHub-RateLimit-Reset": {
                "description": "Upstream window reset (epoch seconds), when known.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (If-None-Match)"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid cursor or pagination parameters"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid credentials (`WWW-Authenticate: Bearer`)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Cross-site request, or organisation not on the allowlist"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Organisation not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid query parameters"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Per-client request rate or upstream-call budget exceeded (see Retry-After)"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "GitHub unavailable and no cached data"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "GitHub rate limit exhausted and no cached data (see Retry-After)"
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "GitHub timed out and no cached data"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List an organisation's public repositories"
      }
    }
  }
}

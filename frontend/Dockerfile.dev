# Dev image: Vite dev server with HMR. Sources are bind-mounted by infra/docker-compose.dev.yml;
# node_modules stays inside the image, so host-platform binaries never leak in.
FROM node:22-slim
RUN npm install -g pnpm@10.34.9
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]

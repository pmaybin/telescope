# Optional. Fine-grained personal access token with read-only access to public repos.
# Leave empty to use unauthenticated GitHub access (60 requests/hour).
# In production, inject from Doppler / 1Password / AWS Secrets Manager rather than a file.
GITHUB_TOKEN=

# How long upstream GitHub responses are cached, in seconds.
CACHE_TTL_SECONDS=600

# Backend log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

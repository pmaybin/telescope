# Optional. Fine-grained personal access token with read-only access to public repos.
# Leave empty to use unauthenticated GitHub access (60 requests/hour).
# In production, inject from Doppler / 1Password / AWS Secrets Manager rather than a file.
GITHUB_TOKEN=

# How long upstream GitHub responses are cached, in seconds.
CACHE_TTL_SECONDS=600

# Backend log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Auth and quota protection (ADR-0013). Defaults shown; uncomment to change. ---
# dev | jwt | tailscale | none. The dev token is NOT a security boundary: use jwt or tailscale in production.
# AUTH_MODE=dev
# AUTH_DEV_SECRET=
# AUTH_JWKS_URL=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# Comma-separated IPs/CIDRs allowed to assert identity or X-Forwarded-For.
# AUTH_TRUSTED_PROXIES=
# USER_RATE_PER_MIN=120
# USER_RATE_BURST=30
# USER_UPSTREAM_BUDGET=100
# USER_UPSTREAM_WINDOW_S=600
# UPSTREAM_RESERVE_FRACTION=0.2
# MAX_CONCURRENT_WALKS=2
# Comma-separated org logins; empty serves any org.
# ORG_ALLOWLIST=

# --- Progressive cold load (ADR-0012). Defaults shown; uncomment to change. ---
# Wait this long for a cold org walk before answering with a provisional page (0 = never wait).
# COLD_WAIT_MS=1500
# first (one upstream preview per cold load) | per-query | off (progress only).
# PREVIEW_MODE=first
# Comma-separated orgs warmed at startup (as the system principal).
# PREWARM_ORGS=
